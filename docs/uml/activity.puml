@startuml activity
' Contact Manager -- activity diagram
' Mirrors the real flow in frontend/js/auth.js and frontend/js/contacts.js.

!theme plain
skinparam shadowing false
skinparam ActivityBackgroundColor White
skinparam ActivityBorderColor Black
skinparam ActivityDiamondBackgroundColor White

title Main User Flow

start

:Open https://contacts.cop4331ruth.lol/;
:index.html loads;

if (readSession() returns a userId?) then (yes)
  :Redirect to contacts.html;
else (no)

  repeat
    if (Already has an account?) then (yes)
      :Fill in the login form;
      :POST Login.php
      { username, password };
    else (no)
      :Fill in the register form;
      :POST Register.php
      { firstName, lastName, username, password };
    endif
  repeat while (response.error is not ""?) is (yes: show the message) not (no)

  :saveSession(userId, firstName, lastName)
  (cookie, 30 minutes);
  :Redirect to contacts.html;
endif

if (requireLogin(): is the cookie still there?) then (no: expired or cleared)
  :Redirect to index.html;
  stop
else (yes)
endif

:POST SearchContacts.php with search = ""
(an empty term returns every contact this user owns);
:renderContacts(results);

repeat
  switch (What does the user do?)
  case (Search)
    :Type a term, pick a field
    (all / name / phone / email);
    :Wait 250 ms (debounce);
    :POST SearchContacts.php
    { userId, search, field };
  case (Add)
    :Fill in the new-contact form;
    :POST AddContact.php
    { userId, firstName, lastName, phone, email };
  case (Edit)
    :Open a card, change the fields;
    :POST EditContact.php
    { userId, id, firstName, lastName, phone, email };
  case (Delete)
    :Confirm in the dialog;
    :POST DeleteContact.php
    { userId, id };
  endswitch

  if (response.error is ""?) then (no)
    :Show the message the API returned;
  else (yes)
    if (Which action was it?) then (search)
      :renderContacts(results);
    else (add / edit / delete)
      :Re-run the search, then renderContacts();
    endif
  endif

repeat while (Keep working?) is (yes) not (log out)

:clearSession();
:Redirect to index.html;

stop

note right
  Every request goes through callApiWithDeadline()
  in frontend/js/api.js, which wraps callApi() with
  a 15 second deadline.

  The API always returns HTTP 200. Errors come back
  in the error field, so the front end checks it on
  every response.
end note

@enduml
